{
  "name": "@eleckoi/dsh-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./desktop-plugin-host": "./dist/desktop-plugin-host.mjs",
    "./session-edit-plugin": "./dist/session-edit-plugin.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run"
  },
  "dependencies": {
    "@eleckoi/dsh-client-characters": "workspace:*",
    "@eleckoi/dsh-client-character-configuration": "workspace:*",
    "@eleckoi/dsh-client-conversations": "workspace:*",
    "@eleckoi/dsh-client-models": "workspace:*",
    "@eleckoi/dsh-client-persona": "workspace:*",
    "@eleckoi/dsh-client-presets": "workspace:*",
    "@eleckoi/dsh-client-roleplay": "workspace:*",
    "@eleckoi/dsh-client-shell": "workspace:*",
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-file-upload": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment-local": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.1.7-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web-frontend": "0.1.7-rc.2",
    "@earendil-works/pi-ai": "0.85.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "tsdown": "0.16.6",
    "typescript": "5.9.3"
  }
}
