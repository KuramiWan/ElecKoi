{
  "name": "@eleckoi/dsh-compatibility-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/types/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib/types",
    "lib/web",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -b --force && node scripts/build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@eleckoi/compatibility-tavern-shared": "workspace:*",
    "@eleckoi/dsh-product-api": "workspace:*",
    "@eleckoi/dsh-product-data": "workspace:*",
    "fflate": "0.8.3",
    "https-proxy-agent": "9.1.0",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "dsh": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiHtmlResources",
        "kind": "contribution",
        "relation": "contributes",
        "owner": "webServer",
        "title": "HTML 显示资源",
        "description": "为导入的 HTML 提供同源浏览器库和静态显示资源，不启动外部脚本库。",
        "mode": "serve-assets",
        "scope": "host"
      }
    ]
  }
}
