{
  "name": "@eleckoi/dsh-client-roleplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./host/*": "./src/host/*",
    "./slots": {
      "types": "./src/slots.d.ts"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-primitives"]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2"
  }
}
