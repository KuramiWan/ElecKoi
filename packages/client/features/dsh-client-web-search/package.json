{
  "name": "@eleckoi/dsh-client-web-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": {
      "types": "./src/client/types.ts",
      "default": "./src/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@eleckoi/dsh-product-api"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "description": "通过 DSH Settings、Credentials 与 Remote 管理联网搜索配置。",
  "engines": {
    "dsh": "0.2.0-rc.2"
  },
  "eleckoi": {
    "developerInterfaces": [
      {
        "id": "eleckoiWebSearch",
        "kind": "service",
        "title": "联网搜索设置服务",
        "description": "分别选择搜索与网页抓取，维护 Tavily、DeepSeek Search 与 Fetch 的配置和独立凭据。",
        "mode": "call",
        "scope": "client",
        "relation": "provides",
        "members": [
          "getSnapshot",
          "subscribe",
          "refresh",
          "update",
          "saveAndTest",
          "test",
          "removeKey"
        ]
      },
      {
        "id": "dsh.web.provider:deepseek-api",
        "kind": "contribution",
        "title": "DeepSeek 搜索与网页抓取",
        "description": "通过官方 Credentials 调用独立 Search、Fetch API，保留完整结果并支持取消。",
        "mode": "register",
        "scope": "host",
        "relation": "contributes",
        "owner": "@deepseek-ai/dsh-web",
        "members": [
          "registerSearchProvider",
          "registerFetchProvider"
        ]
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@eleckoi/dsh-product-api": "workspace:*",
    "@eleckoi/dsh-web-deepseek": "workspace:*"
  }
}
